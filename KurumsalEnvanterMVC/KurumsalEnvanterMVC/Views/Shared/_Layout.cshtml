<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kurumsal Envanter</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- Kurumsal Navigasyon Menüsü -->
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid mx-4">
                <a class="navbar-brand font-weight-bold text-info" asp-area="" asp-controller="Home" asp-action="Index">EnvanterPro</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 gap-2">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">Panel Ana Sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Category" asp-action="Index">Kategori Yönetimi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Employee" asp-action="Index">Personel Yönetimi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Asset" asp-action="Index">Demirbaş & Zimmet</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-5">
        <main role="main" class="pb-3">
            <!-- Dinamik olarak çağrılan alt sayfalar (Index, Create vb.) buraya basılacak -->
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-light fixed-bottom py-2">
        <div class="container text-center">
            &copy; 2026 - Kurumsal Envanter ve Zimmet Takip Sistemi - Suffatech Staj Projesi
        </div>
    </footer>

    <script src~ /lib/jquery/dist/jquery.min.js"></script>
    <script src~ /lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src~ /js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>