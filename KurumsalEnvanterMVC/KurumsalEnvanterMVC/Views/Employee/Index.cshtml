@model IEnumerable<KurumsalEnvanterMVC.Models.Entities.Employee>

@{
    ViewData["Title"] = "Personel Listesi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Kurumsal Envanter - Personel Yönetimi</h2>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Yeni Personel Ekle</a>
    </div>

    <!-- 23. GÜN: Personel Arama Formu -->
    <form asp-action="Index" method="get" class="card card-body bg-light mb-3">
        <div class="row g-2">
            <div class="col-md-9">
                <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Ad, e-posta veya departman ile personel ara..." />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-100">Ara</button>
                <a asp-action="Index" class="btn btn-outline-dark">Temizle</a>
            </div>
        </div>
    </form>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th style="width: 8%">ID</th>
                <th>Adı Soyadı</th>
                <th>E-Posta Adresi</th>
                <th>Departman</th>
                <th style="width: 28%; text-align: center;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EmployeeID</td>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.Department</td>
                    <td class="text-center">
                        <!-- 23. GÜN: Zimmet Detayı Butonu -->
                        <a asp-action="Details" asp-route-id="@item.EmployeeID" class="btn btn-info btn-sm text-white">Zimmet Detayı</a>
                        <a asp-action="Edit" asp-route-id="@item.EmployeeID" class="btn btn-warning btn-sm">Düzenle</a>

                        <form asp-action="Delete" asp-route-id="@item.EmployeeID" method="post" class="d-inline" onsubmit="return confirm
                         ('Bu personeli silmek istediğinize emin misiniz? Zimmet kayıtları etkilenebilir.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>