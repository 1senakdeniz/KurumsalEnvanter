@{
}
@model KurumsalEnvanterMVC.Models.Entities.Employee

@{
    ViewData["Title"] = "Yeni Personel Ekle";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Yeni Personel Tanımla</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Adı Soyadı</label>
                    <input asp-for="FullName" class="form-control" placeholder="Örn: Sena Kara" required />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">E-Posta Adresi</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="Örn: sena@suffatech.com" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Department" class="form-label">Departman</label>
                    <input asp-for="Department" class="form-control" placeholder="Örn: Ar-Ge, İK, Pazarlama" required />
                    <span asp-validation-for="Department" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary btn-sm">İptal</a>
                    <button type="submit" class="btn btn-success btn-sm">Personeli Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>