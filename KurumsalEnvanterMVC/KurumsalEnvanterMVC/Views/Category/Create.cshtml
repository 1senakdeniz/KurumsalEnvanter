@{
}
@model KurumsalEnvanterMVC.Models.Entities.Category

@{
    ViewData["Title"] = "Yeni Kategori Ekle";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Yeni Envanter Kategorisi Tanımla</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="CategoryName" class="form-label">Kategori Adı</label>
                    <input asp-for="CategoryName" class="form-control" placeholder="Örn: Ağ Cihazları, Masaüstü PC" required />
                    <span asp-validation-for="CategoryName" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary btn-sm">İptal</a>
                    <button type="submit" class="btn btn-success btn-sm">Kategoriyi Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>
