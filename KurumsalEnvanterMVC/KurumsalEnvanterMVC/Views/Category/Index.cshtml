@{
}
@model IEnumerable<KurumsalEnvanterMVC.Models.Entities.Category>

@{
    ViewData["Title"] = "Kategori Listesi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Kurumsal Envanter - Kategori Yönetimi</h2>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Yeni Kategori Ekle</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th style="width: 15%">Kategori ID</th>
                <th>Kategori Adı</th>
                <th style="width: 20%; text-align: center;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CategoryID</td>
                    <td>@item.CategoryName</td>
                    <td class="text-center">
                        <button class="btn btn-warning btn-sm">Düzenle</button>
                        <button class="btn btn-danger btn-sm">Sil</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>