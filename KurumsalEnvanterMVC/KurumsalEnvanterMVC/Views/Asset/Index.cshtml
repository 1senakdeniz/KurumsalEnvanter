@model IEnumerable<KurumsalEnvanterMVC.Models.Entities.Asset>

@{
    ViewData["Title"] = "Demirbaş & Zimmet Takibi";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Kurumsal Envanter - Demirbaş & Zimmet Takibi</h2>
        <div class="d-flex gap-2">
            <a asp-action="ExportToCsv" class="btn btn-success btn-sm">Excel / CSV Raporu İndir</a>
            <a asp-action="Create" class="btn btn-primary btn-sm">+ Yeni Demirbaş Kaydet</a>
        </div>
    </div>

    <!-- Arama ve Filtreleme Formu -->
    <div class="card mb-4 bg-light">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2">
                <div class="col-md-5">
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Demirbaş adı veya seri no ile ara..." />
                </div>
                <div class="col-md-4">
                    <select name="categoryId" class="form-select">
                        <option value="">-- Tüm Kategoriler --</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var category in (List<KurumsalEnvanterMVC.Models.Entities.Category>)ViewBag.Categories)
                            {
                                if (ViewBag.CurrentCategory != null && (int)ViewBag.CurrentCategory == category.CategoryID)
                                {
                                    <option value="@category.CategoryID" selected>@category.CategoryName</option>
                                }
                                else
                                {
                                    <option value="@category.CategoryID">@category.CategoryName</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary w-100">Filtrele</button>
                    <a asp-action="Index" class="btn btn-outline-dark">Temizle</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Demirbaş Listesi Tablosu -->
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Seri No</th>
                    <th>Demirbaş Adı</th>
                    <th>Kategori</th>
                    <th>Satın Alma Tarihi</th>
                    <th>Durum</th>
                    <th>Zimmetli Personel</th>
                    <th class="text-center" style="width: 180px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.SerialNumber</td>
                            <td>@item.AssetName</td>
                            <td>@(item.Category != null ? item.Category.CategoryName : "Belirtilmemiş")</td>
                            <td>@item.PurchaseDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (item.Status == "Zimmetlendi")
                                {
                                    <span class="badge bg-warning text-dark">Zimmetlendi</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Stokta</span>
                                }
                            </td>
                            <td>@(item.Employee != null ? item.Employee.FullName : "-")</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.AssetID" class="btn btn-sm btn-outline-primary me-1">Düzenle</a>
                                <form asp-action="Delete" asp-route-id="@item.AssetID" method="post" class="d-inline" onsubmit="return confirm('Bu demirbaşı silmek istediğinize emin misiniz?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-3">Kayıtlı demirbaş bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>